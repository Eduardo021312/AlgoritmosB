#include <cstring>
#include <ctype.h>
#include <iostream>
#include <fstream>
#include <stdlib.h>
#include <string>
#include <time.h>
#include <vector>

using namespace std;

typedef struct {
    string telefone;
    string dadosSessao;
} telefone;

string *split(string frase, string delimitador = " ")
{
    string *vetor = new string[3]; //alocando um vetor de string com 3 posições
    int inicio = 0;
    int fim = frase.find(delimitador);
    int i = 0;
    while (fim != -1) {
        vetor[i] = frase.substr(inicio, fim - inicio);
        inicio = fim + delimitador.size();
        fim = frase.find(delimitador, inicio);
        i++;
    }
    vetor[i] = frase.substr(inicio, fim - inicio);

    return vetor;
}

void carregar(vector<telefone>& dadossessao) {
    ifstream arq("telephony_sessions.txt");
    if (!arq.is_open()) {
        cout << "Erro ao abrir o arquivo.\n";
        return;
    }

    string linha;
    while (getline(arq, linha)) {
        string *partes = split(linha, ";");
        telefone t;
        t.telefone = partes[0];
        t.dadosSessao = partes[1];
        dadossessao.push_back(t);
        delete[] partes;
    }
    arq.close();
}

void  listar(const vector<telefone>& dadossessao) {
    if (dadossessao.empty()) {
        cout << "Nenhum cadastro.\n";
        return;
    }

    cout << "\n telefone:\n";
     for (size_t i = 0; i < dadossessao.size(); i++) {
         cout << i + 1 << " - "
             << dadossessao[i].telefone << " \n ";
             
    }
}
void pesquisar(const vector<telefone>& dadossessao) {
    string telefone;
    cout << "Digite o telefone que deseja pesquisar: ";
    getline(cin, telefone);

    for (size_t i = 0; i < dadossessao.size(); i++) {
        if (dadossessao[i].telefone  == telefone) {
            cout << "Encontrado: " << dadossessao[i].telefone << " - " << dadossessao[i].dadosSessao << "\n";
            return;
        }
    }
    cout << "telefone nao encontrado.\n";
}


int main() {
    vector<telefone> dadossessao;
    int opcao;
	 carregar(dadossessao);

	
    do {
        cout << "MENU\n";
        cout << "1 - Listar telefones\n";
        cout << "2 - Pesquisar telefone e dados de sessao\n";
        cout << "3 - Finalizar\n";
        cout << "Opcao: ";
        cin >> opcao;
        cin.ignore();

        switch (opcao) {
            case 1: 
                //metodo que lista somente os numeros de celular um abaixo do outro e no final mostra a quantidade de celulares exibidos
 				listar(dadossessao);
                break;
            case 2:
                //metodo que o usuario digita um numero de celular, o sistema o localiza e se localizado, mostra seus dados de sessao
                pesquisar(dadossessao);
                break;
            case 3:
                cout << "Programa encerrado.\n";
                break;
            default:
                cout << "Opcao invalida!\n";
                break;
        }
    } while (opcao != 3);

    return 1;
}
